# ==============================================================================
# RecStage Environment Variables
# Copy this file to .env and fill in your values: cp .env.example .env
# ==============================================================================

# TMDB API Key (v3 auth)
# Required only if you want to re-run scripts/fetch_posters.py to fetch posters,
# backdrops, and plots from The Movie Database. The repository already includes
# cached data/posters.json so this key is NOT required to run the application.
# Obtain a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# FastAPI Backend Port (default: 8000)
PORT=8000

# Allowed CORS origins for the FastAPI backend (comma-separated, default: * for local dev)
# Example for production: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Frontend API Base URL (used by Vite when building or running the frontend)
# In local dev, leave empty so Vite automatically proxies /api requests to http://127.0.0.1:8000.
# For production deployments with separated origins (e.g. Vercel + Render):
VITE_API_URL=
